{
  "name": "english-quest",
  "version": "1.4.0",
  "description": "EnglishQuest - แพลตฟอร์มเรียนภาษาอังกฤษแบบเกม: คำศัพท์ Oxford 3000+5000 (A1-C1), แกรมม่า, ห้องแข่ง, ระบบเพื่อน",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "vocab:parse": "python3 scripts/oxford/parse_pdf.py",
    "vocab:normalize": "python3 scripts/oxford/normalize.py",
    "vocab:validate": "node scripts/oxford/validate.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.14",
    "pg": "^8.11.5",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "cmu-pronouncing-dictionary": "^3.0.0",
    "lucide-static": "^1.52.0",
    "wordnet-db": "^3.1.14"
  }
}
