# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้ามอัปโหลด .env ขึ้น GitHub)

# Railway จะสร้างตัวแปรนี้ให้อัตโนมัติเมื่อคุณเพิ่ม PostgreSQL plugin
# ตอนรันบนเครื่องตัวเอง ให้ใส่ connection string ของ Postgres ที่คุณมี
DATABASE_URL=postgresql://user:password@localhost:5432/englishquest

# กุญแจลับสำหรับเข้ารหัส JWT token (เปลี่ยนเป็นข้อความสุ่มยาว ๆ ของตัวเอง)
JWT_SECRET=change-this-to-a-long-random-secret-string

# พอร์ตสำหรับรันเซิร์ฟเวอร์ (Railway จะกำหนดให้เองผ่าน PORT)
PORT=3000

# ใส่ "production" เมื่อ deploy จริง
NODE_ENV=development

# เข้าสู่ระบบด้วย Google (ไม่ตั้ง = ซ่อนปุ่ม) — ดู docs/GOOGLE_LOGIN_SETUP.md
GOOGLE_CLIENT_ID=

# แจ้งเตือนบนโทรศัพท์ (Web Push) — ไม่ตั้งก็ได้: ระบบสร้าง key ให้เองแล้วเก็บในฐานข้อมูล (ตาราง app_settings)
# ถ้าอยากกำหนดเอง สร้างด้วย: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# PUSH_REMINDERS=off   # ปิดการส่งเตือนรายวันทั้งระบบ
# RANKED_EXP_DAILY_CAP=300   # เพดาน EXP จาก Ranked ต่อวัน

# คุยเสียงในเกม Ranked แบบทีม (WebRTC) — ไม่ตั้ง = ใช้ STUN สาธารณะของ Google (คนส่วนใหญ่ใช้ได้)
# ถ้าเครือข่ายบางที่ (เช่น Wi-Fi โรงเรียน/บริษัท) ต่อเสียงไม่ได้ ให้เพิ่ม TURN server เป็น JSON เช่น
# RTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]

# บังคับยืนยันอีเมลสำหรับบัญชีใหม่ (true/false) — เปิดเมื่อ SMTP ส่งอีเมลได้จริงแล้วเท่านั้น
REQUIRE_EMAIL_VERIFICATION=false
# URL ของเว็บสำหรับลิงก์ในอีเมล (แนะนำให้ตั้งใน production)
# APP_URL=https://english-quest.up.railway.app
